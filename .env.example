# Copy to .env.local and fill in from your Supabase project settings.
# Settings → API. `.env.local` is gitignored; never commit real keys.

# Safe to expose to the browser — row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional server-only aliases. On Vercel these are read at runtime (and at
# build, they override a stale NEXT_PUBLIC_* baked into the client bundle).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Bypasses row-level security entirely, so it must never be
# prefixed with NEXT_PUBLIC_ or imported into a client component.
# Needed for admin actions such as creating a user on someone's behalf.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
