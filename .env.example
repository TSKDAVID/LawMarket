# Public site origin, used for canonical URLs, hreflang alternates, sitemap.
NEXT_PUBLIC_SITE_URL=https://lawmarket.ge

# Payments. "mock" until Flitt credentials arrive; the adapter swap happens
# behind src/lib/payments/provider.ts and touches no UI code.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=dev-only-signing-secret-change-me

# Flitt (unused at the mock stage; required by the future FlittProvider).
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# Privacy-friendly analytics (Plausible). Script loads only when set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Error tracking (wired at launch, non-blocking).
SENTRY_DSN=
